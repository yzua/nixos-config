+/** Keep the transport envelope distinct from parameters such as subagent.name. */
+export function toolCallEnvelopeHint(tools?: Tool[]): string {
+  const rules = 'Use exactly two top-level keys: "name" for the Pi tool and "arguments" for its parameter object. Put ALL tool parameters inside "arguments", including any parameter also called "name". Never flatten tool parameters into the envelope or emit duplicate top-level keys.';
+  if (!tools?.some((tool) => tool.name === "subagent")) return rules;
+  return rules + '\nSubagent nesting example (schema illustration, not a request): ' +
+    '{"name":"subagent","arguments":{"agent":"scout","name":"example-scout","task":"Reply with a short acknowledgement."}}';
+}
